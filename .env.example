# Copy to .env and fill in real values. Never commit .env with real secrets.
# JWT signing secret for the Spring backend (Base64-encoded, 256-bit minimum).
JWT_SECRET=your-base64-encoded-jwt-secret
# Gmail app password used by the backend mail sender (spring.mail.password).
SPRING_MAIL_PASSWORD=your-gmail-app-password

# Port the Spring backend listens on (compose + README advertise 8080).
SERVER_PORT=8080
# MySQL connection for the backend (docker-compose sets these on the container network).
SPRING_DATASOURCE_URL=jdbc:mysql://<db-host>:3306/car_rental_system?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
